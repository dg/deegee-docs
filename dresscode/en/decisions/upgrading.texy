upgrading:
	syntax:
		octalPrefix: required
```

```php .[before]
$mode = 0755;  // The octal number `0755` must be written `0o755`.
$zero = 0;
$flags = 0x1F;
```

```php .[after]
$mode = 0o755;
$zero = 0;
$flags = 0x1F;
```


